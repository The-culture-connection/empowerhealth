{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Always fetch the newest harness and app shell so testers see new builds.
	@shell path / /index.html /build.json /app/ /app/index.html /app/flutter_bootstrap.js /app/flutter_service_worker.js /app/version.json
	header @shell Cache-Control "no-cache"

	redir /app /app/ 308

	# The app under test (QA build), loaded by the harness in an iframe.
	handle /app/* {
		try_files {path} /app/index.html
		file_server
	}

	# The QA harness page.
	handle {
		try_files {path} /index.html
		file_server
	}
}
